meta {
  name: Update plan as member
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/api/memberships/{{memberId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{memberToken}}
}

body:json {
  {
    "plan": "enterprise"
  }
}

tests {
  test("status is 403", function() {
    expect(res.status).to.equal(403);
  });
}
