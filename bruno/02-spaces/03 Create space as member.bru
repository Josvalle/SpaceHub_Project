meta {
  name: Create space as member
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/spaces
  body: json
  auth: bearer
}

auth:bearer {
  token: {{memberToken}}
}

body:json {
  {
    "name": "Bruno Room",
    "type": "private_room",
    "capacity": 4,
    "pricePerHour": 20,
    "location": "San Jose"
  }
}

tests {
  test("status is 403", function() {
    expect(res.status).to.equal(403);
  });
}
