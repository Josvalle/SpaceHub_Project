meta {
  name: Create space without token
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/spaces
  body: json
  auth: none
}

body:json {
  {
    "name": "Bruno Room",
    "type": "private_room",
    "capacity": 4,
    "pricePerHour": 20,
    "location": "San Jose"
  }
}

tests {
  test("status is 401", function() {
    expect(res.status).to.equal(401);
  });
}
