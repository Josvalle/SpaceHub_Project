meta {
  name: Register member 2
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Member Two",
    "email": "{{member2Email}}",
    "password": "12345678"
  }
}

vars:post-response {
  member2Token: res.body.token
  member2Id: res.body.user.id
}

tests {
  test("status is 201", function() {
    expect(res.status).to.equal(201);
  });
}
