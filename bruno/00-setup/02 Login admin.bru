meta {
  name: Login admin
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

vars:post-response {
  adminToken: res.body.token
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("admin user has role admin (run npm run seed, see README)", function() {
    expect(res.body.user.role).to.equal("admin");
  });
}
