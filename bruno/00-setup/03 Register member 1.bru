meta {
  name: Register member 1
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Member One",
    "email": "{{memberEmail}}",
    "password": "12345678"
  }
}

vars:post-response {
  memberToken: res.body.token
  memberId: res.body.user.id
}

tests {
  test("status is 201", function() {
    expect(res.status).to.equal(201);
  });
}
