}

post {
  url: {{baseUrl}}/api/reservations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{memberToken}}
}

body:json {
  {
    "spaceId": {{spaceId}},
    "startTime": "{{startTime}}",
    "endTime": "{{endTime}}"
  }
}

tests {
