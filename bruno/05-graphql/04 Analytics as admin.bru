meta {
  name: Analytics as admin
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/graphql
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "query": "{ analytics(from: \"2100-01-01T00:00:00Z\", to: \"2110-01-01T00:00:00Z\") { occupancy { location type totalSpaces bookedHours occupancyRate } revenue { period total bookings } membershipsExpiring { name plan } topUsers { name bookings } } }"
  }
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("returns the four metrics", function() {
    expect(res.body.errors).to.equal(undefined); var a = res.body.data.analytics; expect(a.occupancy).to.be.an("array"); expect(a.revenue).to.be.an("array"); expect(a.membershipsExpiring).to.be.an("array"); expect(a.topUsers).to.be.an("array");
  });
}
