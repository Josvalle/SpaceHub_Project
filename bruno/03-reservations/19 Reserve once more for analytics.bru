meta {
  name: Reserve once more for analytics
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/api/reservations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{memberToken}}
}

body:json {
  {
    "spaceId": {{spaceId}},
    "startTime": "{{startTime}}",
    "endTime": "{{endTime}}"
  }
}

tests {
  test("status is 201", function() {
    expect(res.status).to.equal(201);
  });
}
