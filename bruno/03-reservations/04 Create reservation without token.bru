meta {
  name: Create reservation without token
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/reservations
  body: json
  auth: none
}

body:json {
  {
    "spaceId": {{spaceId}},
    "startTime": "{{startTime}}",
    "endTime": "{{endTime}}"
  }
}

tests {
  test("status is 401", function() {
    expect(res.status).to.equal(401);
  });
}
