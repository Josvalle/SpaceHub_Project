meta {
  name: Create reservation end before start
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/reservations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{memberToken}}
}

body:json {
  {
    "spaceId": {{spaceId}},
    "startTime": "{{endTime}}",
    "endTime": "{{startTime}}"
  }
}

tests {
