meta {
  name: Register duplicated email
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "New User",
    "email": "{{newEmail}}",
    "password": "12345678"
  }
}

tests {
  test("status is 409", function() {
    expect(res.status).to.equal(409);
  });

  test("returns a json error", function() {
    expect(res.body.error).to.be.a("string");
  });
}
