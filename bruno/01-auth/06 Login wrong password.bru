meta {
  name: Login wrong password
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{memberEmail}}",
    "password": "wrongpassword"
  }
}

tests {
  test("status is 401", function() {
    expect(res.status).to.equal(401);
  });
}
