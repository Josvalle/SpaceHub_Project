meta {
  name: Register ok
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "New User",
    "email": "{{newEmail}}",
    "password": "12345678"
  }
}

tests {
  test("status is 201", function() {
    expect(res.status).to.equal(201);
  });

  test("returns a token", function() {
    expect(res.body.token).to.be.a("string");
  });

  test("new users are members", function() {
    expect(res.body.user.role).to.equal("member");
  });

  test("password is not returned", function() {
    expect(res.body.user.password).to.equal(undefined);
  });
}
